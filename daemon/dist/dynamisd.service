[Unit]
Description=Dynamis Power (power profiles that learn your laptop)
Documentation=https://github.com/hirejohndougan-art/Dynamis-Power
# Only one service may own the power-profiles interface.
Conflicts=power-profiles-daemon.service tuned-ppd.service
After=dbus.service

[Service]
Type=dbus
BusName=org.freedesktop.UPower.PowerProfiles
ExecStart=/usr/local/libexec/dynamisd
Restart=on-failure
RestartSec=5
# A normal stop (including every normal shutdown) removes the marker. A boot
# that finds it still there follows a freeze, crash or power cut; three in a
# row switch on safe mode. See daemon/crates/dynamis-core/src/boots.rs.
ExecStopPost=/bin/rm -f /var/lib/dynamis-power/running
StateDirectory=dynamis-power
StateDirectoryMode=0700

# --- Hardening -------------------------------------------------------------
# No network at all: the daemon only speaks D-Bus over a local socket.
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
# The whole filesystem is read-only except the state directory and the kernel
# interfaces under /sys and /proc/sys it tunes. ProtectKernelTunables= is
# deliberately NOT set: it would make those read-only too.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
# Apps (phase 6) change one file, cpu.weight, in app groups of user
# sessions. The cgroup tree is read-only except user.slice; the daemon's own
# writer also refuses anything but cpu.weight there.
ProtectControlGroups=no
ReadOnlyPaths=/sys/fs/cgroup
ReadWritePaths=-/sys/fs/cgroup/user.slice
ProtectClock=yes
ProtectHostname=yes
NoNewPrivileges=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Well above the 20 MB target; a runaway daemon is stopped, not the laptop.
MemoryMax=64M
# TODO after the real-hardware test: drop capabilities to the minimum the
# settings need (CapabilityBoundingSet=).

[Install]
WantedBy=graphical.target
